# Example .env file for pi-db
# DO NOT commit real credentials to version control

# Database connection settings
DB_HOST=database.example.internal
DB_PORT=3306
DB_USER=agent_reader
DB_PASSWORD=replace-with-strong-random-password
DB_NAME=analytics

# Notes:
# - These are example values only, not real credentials
# - Use a dedicated read-only database account (see mysql-readonly-user.sql.example)
# - Keep this file out of version control (.gitignore)
# - The envPrefix in pi-db.json determines which variables are used (e.g., DB_ or MYAPP_DB_)
