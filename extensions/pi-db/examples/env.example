# Example .env file for pi-db
# DO NOT commit real credentials to version control

# Database connection settings
DB_HOST=database.example.internal
DB_PORT=3306
DB_USER=agent_reader
DB_PASSWORD=replace-with-strong-random-password
DB_NAME=analytics

# Notes:
# - These are example values only, not real credentials
# - Use a dedicated read-only database account (see mysql-readonly-user.sql.example)
# - Keep this file out of version control (.gitignore)
# - The envPrefix in pi-db.json determines which variables are used (e.g., DB_ or MYAPP_DB_)

# --- Read-only credentials for pi-db ---
# Use a dedicated read-only account. The prefix must match `envPrefix` in
# .pi/pi-db.json - either the top-level value or a target's own envPrefix.
UZIS_RO_DB_HOST=
UZIS_RO_DB_PORT=
UZIS_RO_DB_NAME=
UZIS_RO_DB_USER=
UZIS_RO_DB_PASSWORD=

# With `targets`, give each environment its own file rather than stacking
# credentials in one .env, e.g.:
#   .env.pi-db.prod
#   .env.pi-db.formal
# Every one of them must be gitignored.
